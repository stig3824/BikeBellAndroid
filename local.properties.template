# BikeBell Local Properties Template
# Copy this file to local.properties and update with your keystore details

# SDK location (update with your Android SDK path)
sdk.dir=/Users/username/Library/Android/sdk

# Release signing configuration
# Uncomment and update these after generating the keystore
# RELEASE_STORE_FILE=keystore/bikebell-release-key.jks
